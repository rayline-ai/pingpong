# Copy to .env and fill in. .env is git-ignored.

# ---------------------------------------------------------------------------
# Rayline — the one credential the whole system shares
# ---------------------------------------------------------------------------
# Router key (rlk-...) for the Rayline hosted cloud. Mint one at
# https://platform.rayline.ai/keys.
#
# Which models the agents actually get is decided in rayline/pingpong.json, not
# here. Nothing in this file names a model.
RAYLINE_ROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Forgejo
# ---------------------------------------------------------------------------
# Two Forgejo accounts, one per role, so the PR shows which agent did what.
# Create both after the first `docker compose up`, each with repo read/write, and
# take a token from Settings -> Applications.
#
#   pingpong-reviewer  posts the reviews and does every API read
#   pingpong-coder     authors and pushes the fix commits; its account email must
#                      be BOT_EMAIL below, since that is what links a commit to it
#
# One account works too — leave FORGEJO_CODER_TOKEN empty and it falls back — but
# then the reviewer appears to have written the fixes, because Forgejo credits an
# "added N commits" event to whoever pushed rather than to the commit's author.
FORGEJO_REVIEWER_TOKEN=
FORGEJO_CODER_TOKEN=

# Shared secret for webhook signatures. Any long random string; paste the same
# value into the repository webhook in Forgejo.
PINGPONG_WEBHOOK_SECRET=

# Public URL of your Forgejo, used for links it generates.
FORGEJO_ROOT_URL=http://localhost:3000/

FORGEJO_PORT=3000
FORGEJO_SSH_PORT=2222
API_PORT=8080

# Optional. Only needed if a role in rayline/pingpong.json points at the
# `openrouter` endpoint. Mint one at openrouter.ai/keys.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Loop
# ---------------------------------------------------------------------------
# Max review/fix rounds per PR. Counted from the coder's commits, so this is
# also the webhook-storm guard.
MAX_ROUNDS=3

# Truncate very large diffs before sending them to the reviewer.
MAX_DIFF_BYTES=60000

# Per-invocation timeouts, seconds.
REVIEW_TIMEOUT=900
FIX_TIMEOUT=1800

# ---------------------------------------------------------------------------
# Bot identity
# ---------------------------------------------------------------------------
# BOT_EMAIL is load-bearing: rounds are counted by matching commit authors
# against it. Change it and the round counter resets.
BOT_NAME=pingpong-coder
BOT_EMAIL=pingpong-coder@local
