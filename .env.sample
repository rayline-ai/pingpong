# Copy to .env and fill in. .env is git-ignored.

# ---------------------------------------------------------------------------
# Where the agents get a brain
# ---------------------------------------------------------------------------
# Three ways, and they share nothing:
#
#   router      Rayline routes every request. rayline/pingpong.json picks a model
#               per role, so the two agents can differ — which is the point of
#               the exercise. Needs a key for whichever provider you pick, below.
#   claude-sub  No router. Hermes uses the Claude subscription this host is
#               already logged into, read straight from ~/.claude. Run `claude`
#               and sign in once, and `up` does the rest.
#   codex-sub   No router either, on a ChatGPT subscription. Each agent gets a
#               session of its OWN: run `./pingpong login` once after `up` and
#               sign in twice, with a device code.
#
# Why codex-sub does not just read ~/.codex the way claude-sub reads ~/.claude:
# Claude's credential file is refreshed in place, so host and containers stay on
# one token. Codex rotates its refresh token on every refresh and does not write
# the new one back, so borrowing that file would work exactly once and then leave
# YOUR `codex` command signed out. Nothing here touches it.
#
# What the subscription modes cost you: one account, two agents. Both roles run
# on the same model, so a review and the fix it asks for come from the same brain
# and agree with each other more than they should; every round counts against one
# subscription's limits; and rayline/pingpong.json is not read at all. Check your
# plan's terms before leaving this running unattended.
AGENT_MODE=router

# Only for the subscription modes, and required by them. There is no router to
# resolve `reviewer-brain` into anything, so Hermes needs the real model id.
#
#   claude-sub  claude-sonnet-4-6
#   codex-sub   gpt-5.5 — and NOT gpt-5.5-codex. A ChatGPT account is refused
#               for every -codex id with "not supported when using Codex with a
#               ChatGPT account", which reads like a broken model name.
SUBSCRIPTION_MODEL=

# Filled in by `pingpong up`, for claude-sub only: the host directory holding
# that login, mounted into both agents. Not written by hand — compose
# interpolates this file and cannot expand `~`, and $HOME is routinely unset on
# Windows. codex-sub leaves it alone; it mounts nothing from the host.
CREDENTIALS_DIR=

# ---------------------------------------------------------------------------
# Model credentials  (AGENT_MODE=router only)
# ---------------------------------------------------------------------------
# Which models the agents actually get is decided in rayline/pingpong.json, not
# here. Nothing in this file names a model — these are only the keys the
# endpoints in that file draw on, and you need the one(s) your two roles route
# to.
#
# Leave this whole section empty and run `./pingpong model`. Nothing ships
# chosen, so that step is not optional and `up` refuses without it; it asks for
# a provider first and then only for the key that provider needs, writing it
# back here. Filling these in by hand first is allowed and buys nothing.
#
# Router key (rlk-...) for the Rayline hosted cloud. Mint one at
# https://platform.rayline.ai/keys.
RAYLINE_ROUTER_API_KEY=

# Only if a role points at `anthropic-direct` or `openai-direct`. Compose passes
# these into the agents under different names — RAYLINE_ANTHROPIC_API_KEY and
# RAYLINE_OPENAI_API_KEY — because ANTHROPIC_API_KEY already means something in
# those containers: Hermes sends it to the local router as a placeholder, and a
# real key under that name would let a bypassed router look like a working one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Only if a role points at the `openrouter` endpoint. Mint one at
# openrouter.ai/keys. Passed to the agents as RAYLINE_OPENROUTER_API_KEY, for
# the same reason as the two above: one prefix, one rule, no exceptions to
# remember.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Forgejo
# ---------------------------------------------------------------------------
# Two Forgejo accounts, one per role, so the PR shows which agent did what.
#
#   pingpong-reviewer  posts the reviews and does every API read
#   pingpong-coder     authors and pushes the fix commits; its account email must
#                      be BOT_EMAIL below, since that is what links a commit to it
#
# Create both after the first `./pingpong up` — SETUP.md step 1 — with
# Forgejo's own CLI rather than the sign-up page, which is disabled:
#
#   docker compose exec -u git forgejo forgejo admin user create \
#       --username pingpong-coder --email pingpong-coder@local \
#       --random-password --must-change-password=false
#   docker compose exec -u git forgejo forgejo admin user generate-access-token \
#       --username pingpong-coder --token-name pingpong --raw \
#       --scopes write:repository,write:issue
#
# --must-change-password=false is load-bearing: Forgejo enforces a first-login
# password change on the API too, and nothing ever logs in as these two, so
# without it every call the token makes returns 403 "You must change your
# password" and reads as a permissions problem.
#
# One account works too — leave FORGEJO_CODER_TOKEN empty and it falls back — but
# then the reviewer appears to have written the fixes, because Forgejo credits an
# "added N commits" event to whoever pushed rather than to the commit's author.
FORGEJO_REVIEWER_TOKEN=
FORGEJO_CODER_TOKEN=

# Only if you named the bot accounts something other than the two above. These
# are the logins PingPong excludes from triggering a round, and `onboard` adds as
# collaborators. Rename the accounts without setting these and the exclusion
# checks a login that does not exist: the bots' own events then start rounds.
#REVIEWER_LOGIN=pingpong-reviewer
#CODER_LOGIN=pingpong-coder

# Shared secret for webhook signatures. Any long random string; paste the same
# value into the repository webhook in Forgejo.
PINGPONG_WEBHOOK_SECRET=

# Public URL of your Forgejo, used for links it generates. `pingpong up` fills
# this in with the address of the interface this machine routes through, and
# leaves it alone once it holds anything that is not the placeholder or a
# localhost. Set it by hand if that picks the wrong interface, or if the instance
# is reached through a name rather than an address.
#
# It is not cosmetic and it is not localhost: Forgejo builds clone URLs and
# webhook links from this, so a localhost value hands every other machine a URL
# pointing back at itself — silently, and only for other people.
FORGEJO_ROOT_URL=http://<ip-address>:23000/

# Host interface the published ports bind to. Empty means every interface. Set it
# to the machine's LAN address to serve only that network.
BIND_ADDR=

# Published host ports. Deliberately not 3000/8080/2222: on a machine that also
# runs other development stacks those three are the most contended numbers there
# are, and a collision here surfaces as a container that will not start rather
# than as anything that names the real cause. These are host-side only — inside
# the compose network the services still speak 3000 and 8080, which is why the
# webhook target stays `http://api:8080/webhook` whatever you set below.
FORGEJO_PORT=23000
FORGEJO_SSH_PORT=23022
API_PORT=23080

# ---------------------------------------------------------------------------
# Loop
# ---------------------------------------------------------------------------
# Max review/fix rounds per PR. Counted from the coder's commits, so this is
# also the webhook-storm guard.
MAX_ROUNDS=3

# Truncate very large diffs before sending them to the reviewer.
MAX_DIFF_BYTES=60000

# Per-invocation timeouts, seconds.
REVIEW_TIMEOUT=900
FIX_TIMEOUT=1800

# ---------------------------------------------------------------------------
# Bot identity
# ---------------------------------------------------------------------------
# BOT_EMAIL is load-bearing: rounds are counted by matching commit authors
# against it. Change it and the round counter resets.
BOT_NAME=pingpong-coder
BOT_EMAIL=pingpong-coder@local
