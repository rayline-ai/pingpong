#!/usr/bin/env bash
# Thin wrapper. `pingpong up|down|logs` drive compose, and `accounts` and
# `onboard` run on the host — they need the operator's folder, ~/.netrc and
# `docker compose exec`, none of which the API container can see. Anything else
# is passed straight to the CLI inside that container.
set -euo pipefail

cd "$(dirname "$0")"

case "${1:-}" in
    up)      shift; exec docker compose up -d --build "$@" ;;
    down)    shift; exec docker compose down "$@" ;;
    logs)    shift; exec docker compose logs -f "${@:-api}" ;;
    accounts) shift; exec ./accounts.sh "$@" ;;
    onboard)  shift; exec ./onboard.sh "$@" ;;
    ""|-h|--help)
        echo "usage: pingpong up|down|logs"
        echo "       pingpong accounts [--user someone@example.com]"
        echo "       pingpong onboard ../some-repo"
        echo "       pingpong doctor"
        echo "       pingpong round owner/repo#123"
        exit 0 ;;
esac

exec docker compose exec api python -m src.cli "$@"
